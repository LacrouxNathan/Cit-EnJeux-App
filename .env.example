DB_PASSWORD=remplacer-par-un-secret-local
APP_PORT=8080
# false uniquement pour HTTP local ; true si l’application est exposée en HTTPS.
COOKIE_SECURE=false

# Premier démarrage : activer et compléter ; désactiver après création du compte.
CEJ_BOOTSTRAP_ENABLED=false
CEJ_BOOTSTRAP_EMAIL=
CEJ_BOOTSTRAP_PASSWORD=
CEJ_BOOTSTRAP_FIRST_NAME=
CEJ_BOOTSTRAP_LAST_NAME=

# Invitations : Mailpit collecte les emails localement sur http://localhost:8025.
PUBLIC_URL=http://localhost:8080
INVITATION_HOURS=48
MAILPIT_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@citeenjeux.local

# Import d’une fiche depuis son lien BGG : jeton d’application approuvée.
BGG_API_TOKEN=
